{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/vite"
    }
  ],
  "routes": [
    {
      "src": "/api/plagiarism",
      "dest": "api/index.py"
    },
    {
      "src": "/api/extract-pdf",
      "dest": "api/index.py"
    },
    {
      "src": "/api/py/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
